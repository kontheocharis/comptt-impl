let 0 Nat : U = (0 A : U) -> A -> (A -> A) -> A;
let zero : Nat = \A z s. z;
let succ : Nat -> Nat = \n A z s. s (n A z s);
let 0 Eq : (0 A : U) -> (0 x : A) -> (0 y : A) -> U
  = \A x y. (0 P : (0 _ : A) -> U) -> (0 _ : P x) -> P y;
let 0 refl : (0 A : U) -> (0 x : A) -> Eq A x x = \A x P px. px;
let r : Nat = ~_;
let 0 assert : Eq Nat r zero = refl Nat zero;
zero
